// =====================================================     
// ITEM DO CARRINHO    
// =====================================================     
public class ItemCarrinho     
{         
    public Produto Produto { get; set; }          
    public int Quantidade { get; set; }          
    // CALCULAR SUBTOTAL         
    public decimal CalcularSubtotal()         
    {             
        return Produto.Preco * Quantidade;         
    }     
}      
// =====================================================
// CLASSE CARRINHO
// =====================================================
public class Carrinho
{
    public List<ItemCarrinho> Itens = new List<ItemCarrinho>();
    // ADICIONAR PRODUTO
    public void AdicionarProduto(Produto produto, int quantidade)
    {
        // VALIDAR ESTOQUE
        if (quantidade > produto.Estoque)
        {
            Console.WriteLine("Estoque insuficiente para o produto: " + produto.Nome);
            Console.WriteLine("Estoque disponível: " + produto.Estoque);
            Console.WriteLine();
            return;
        }
        ItemCarrinho item = new ItemCarrinho();
        item.Produto = produto;
        item.Quantidade = quantidade;
        Itens.Add(item);
        // DIMINUIR ESTOQUE
        produto.Estoque -= quantidade;
        Console.WriteLine(produto.Nome + " foi adicionado ao carrinho!");
        Console.WriteLine("Quantidade: " + quantidade);
        Console.WriteLine("Estoque restante: " + produto.Estoque);
        Console.WriteLine();
    }
    // CALCULAR TOTAL
    public decimal CalcularTotal()
    {
        decimal total = 0;

        foreach (var item in Itens)
        {
            total += item.CalcularSubtotal();
        }

        return total;
    }
    // LISTAR CARRINHO
    public void ListarCarrinho()
    {
        Console.WriteLine("========== CARRINHO ==========");
        decimal total = 0;
        foreach (var item in Itens)
        {
            decimal subtotal = item.CalcularSubtotal();
            Console.WriteLine("Produto: " + item.Produto.Nome);
            Console.WriteLine("Quantidade: " + item.Quantidade);
            Console.WriteLine("Subtotal: R$" + subtotal);
            Console.WriteLine();
            total += subtotal;
        }
        Console.WriteLine("VALOR TOTAL: R$" + total);
        Console.WriteLine("==============================");
        Console.WriteLine();
    }
}    
